{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenloom.github.io/cannabis-product-schema/v0.1/core/product.schema.json",
  "title": "Product",
  "description": "Scope-neutral: no store_id. Representable-everything — a product no jurisdiction currently allows at retail (flower, marijuana) is still valid core data; jurisdiction eligibility is a profile concern (see product_form/regulatory_class).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": {
      "type": "object",
      "description": "Localized display name, keyed by BCP 47 language tag (e.g. \"en\", \"en-US\").",
      "propertyNames": { "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]+)*$" },
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 1
    },
    "description": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "brand": { "$ref": "party.schema.json" },
    "product_form": { "$ref": "defs/vocab.schema.json#/$defs/product_form" },
    "regulatory_class": {
      "$ref": "defs/vocab.schema.json#/$defs/regulatory_class"
    },
    "strain": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "classification": { "type": "string" }
      },
      "additionalProperties": false
    },
    "categories": { "type": "array", "items": { "type": "string" } },
    "packages": {
      "type": "array",
      "items": { "$ref": "package.schema.json" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-form namespace for profile-specific additions. Profiles restrict core, never extend it outside this map."
    }
  },
  "required": ["id", "name", "product_form", "regulatory_class"],
  "additionalProperties": false
}
